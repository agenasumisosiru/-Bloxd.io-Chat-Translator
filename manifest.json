{
  "manifest_version": 3,
  "name": "Bloxd.io JP Chat Translator",
  "version": "1.4.0",
  "version_name": "1.4.0",
  "description": "Translate Bloxd.io chat messages and check for updates at browser startup.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Bloxd Translator"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bloxd.io/*",
        "https://geologies.top/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
